# VIBE - AI for Humanity Environment Variables

# App Environment & Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Optional AI enhancement (Gemini API for warm conversational icebreakers and match explanations)
# If omitted or empty, VIBE seamlessly falls back to the deterministic explainable matching engine.
GEMINI_API_KEY=

# Session / JWT Secret (min 32 characters in production)
SESSION_SECRET=vibe_super_secret_local_development_key_change_in_production_32chars

# Railway Assistance & Grievance Directory Reference (Official numbers)
NEXT_PUBLIC_RAIL_MADAD_HELPLINE=139
NEXT_PUBLIC_WOMEN_SAFETY_HELPLINE=1091

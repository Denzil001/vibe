# COMPARTMENT / VIBE Environment Variables
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server-Only (Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only AI enhancement (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Boarding & Pass Security (Never prefix with NEXT_PUBLIC_)
BOARDING_MODE=allowlist
BOARDING_CODE_PEPPER=
DEMO_JOURNEY_ID=
DEMO_ADMIN_SECRET=
SESSION_SECRET=vibe_super_secret_local_development_key_change_in_production_32chars

# Railway Assistance & Helplines (Official numbers)
NEXT_PUBLIC_RAIL_MADAD_HELPLINE=139
NEXT_PUBLIC_WOMEN_SAFETY_HELPLINE=1091
